<% layout ("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-8 offset-2">

    
<h1>Edit Listing</h1>
<form action="/listings/<%= listing._id %>?_method=PUT" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">
    <div class="mb-3">
        <label for="title" class="form-label">Title:</label>
        <input type="text" id="title" name="title" value="<%= listing.title %>" required class="form-control" required>
    </div>
    
    <div class="mb-3">
        <label for="description" class="form-label">Description:</label>
        <textarea id="description" name="description" required class="form-control" required><%= listing.description %></textarea>
    </div>
    
    <div class="mb-3">
        <label for="location" class="form-label">Location:</label>
        <input type="text" id="location" name="location" value="<%= listing.location %>" required class="form-control" required>
    </div>
    
    <div class="row">
        <div class="mb-3 col-md-4">
        <label for="price" class="form-label">Price:</label>
        <input type="number" id="price" name="price" value="<%= listing.price %>" required class="form-control" required>
    </div>
    <div class="mb-3 col-md-8">
        <label for="country" class="form-label">Country:</label>
        <input type="text" id="country" name="country" value="<%= listing.country %>" required class="form-control" required>
    </div>
    </div>
    
    <div class="mb-3">
        Original Listing Image <br>
        <img src="<%= listing.image.url %>" class="edit-preview-img" alt="Current listing image">
    </div>

    <div class="mb-3">
        <label for="image" class="form-label">Upload New Image:</label>
        <input type="file" id="image" name="image" value="<%= listing.image.url %>" class="form-control">
    </div><br>
    
    <div class="edit-btns">
        <button type="submit" class="edit-btn btn-dark edit-btn">Save Changes</button>
        <a href="/listings/<%= listing._id %>" class="edit-Cancel-btn">Cancel</a>
    </div><br>
</form>

</div>
</div>
